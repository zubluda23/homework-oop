<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ShopMAUI"
             x:Class="ShopMAUI.MainPage"
             Title="Product Catalog">

    <Grid RowDefinitions="Auto, Auto, *, Auto"
          Padding="20"
          RowSpacing="15">

        <!-- Заголовок -->
        <Label Grid.Row="0"
               Text="Product Management System"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Шапка таблиці -->
        <Border Grid.Row="1"
                Stroke="#CCCCCC"
                StrokeThickness="1"
                Background="#2B3A42"
                Padding="10, 8">
            <Grid ColumnDefinitions="2*, 1*, 1.5*, 1.5*, 3*">
                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" TextColor="White" />
                <Label Grid.Column="1" Text="Price" FontAttributes="Bold" TextColor="White" />
                <Label Grid.Column="2" Text="Country" FontAttributes="Bold" TextColor="White" />
                <Label Grid.Column="3" Text="Pack Date" FontAttributes="Bold" TextColor="White" />
                <Label Grid.Column="4" Text="Details" FontAttributes="Bold" TextColor="White" />
            </Grid>
        </Border>

        <!-- Таблиця з переліком товарів -->
        <Border Grid.Row="2"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                Padding="0">
            <CollectionView x:Name="ProductsCollectionView"
                            SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Grid ColumnDefinitions="2*, 1*, 1.5*, 1.5*, 3*"
                              Padding="10, 8">
                            <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:F2} ₴'}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding CountryOfOrigin}" VerticalOptions="Center" />
                            <Label Grid.Column="3" Text="{Binding PackagingDate, StringFormat='{0:yyyy-MM-dd}'}" VerticalOptions="Center" />
                            <Label Grid.Column="4" Text="{Binding Details}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Кнопки дій -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*, *, *"
              ColumnSpacing="15">
            <Button Grid.Column="0"
                    Text="+ Add Food"
                    Clicked="OnAddFoodClicked"
                    BackgroundColor="#2E7D32"
                    TextColor="White" />

            <Button Grid.Column="1"
                    Text="+ Add Book"
                    Clicked="OnAddBookClicked"
                    BackgroundColor="#1565C0"
                    TextColor="White" />

            <Button Grid.Column="2"
                    Text="- Delete Selected"
                    Clicked="OnDeleteClicked"
                    BackgroundColor="#C62828"
                    TextColor="White" />
        </Grid>

    </Grid>
</ContentPage>